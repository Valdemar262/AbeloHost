{
    "name": "valdemar262/abelohost-blog",
    "description": "A simple PHP blog built with MySQL and Smarty.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "smarty/smarty": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {
        "lint": "find bin config public src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "serve": "php -d display_errors=0 -S 127.0.0.1:8080 -t public public/router.php",
        "check-db": "@php bin/check-db.php",
        "test": "@php tests/foundation.php",
        "test:http": "@php tests/http.php"
    }
}
